      "source": [
        "n = int(input(\"Enter a number: \"))\n",
        "sum = 0\n",
        "while n > 0:\n",
        "    rem = n % 10\n",
        "    sum = sum + rem\n",
        "    n = n // 10\n",
        "print(\"Sum of digits =\", sum)"
      ],
