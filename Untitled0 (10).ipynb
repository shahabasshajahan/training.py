        "n = int(input(\"Enter number of elements: \"))\n",
        "a = []\n",
        "for i in range(n):\n",
        "    a.append(int(input(\"Enter element: \")))\n",
        "x = int(input(\"Enter element to count: \"))\n",
        "count = 0\n",
        "for i in range(n):\n",
        "    if a[i] == x:\n",
        "        count = count + 1\n",
        "print(\"Occurrence:\", count)"
