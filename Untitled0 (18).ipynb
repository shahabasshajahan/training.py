      "source": [
        "n=int(input(\"Enter a number:\"))\n",
        "a=n\n",
        "t=0\n",
        "while(n>0):\n",
        "  r=n%10\n",
        "  t=(t*10)+r\n",
        "  n=n//10\n",
        "if(a==t):\n",
        "  print(\"Palindrome\")\n",
        "else:\n",
        "  print(\"Not Palindrome\")"
      ],
